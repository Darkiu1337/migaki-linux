+// The vendored CuNNy networks, in `GamescopeUpscaleFilter` order: 4x12-NVL,
+// 4x16-NVL (the default), 4x24-NVL and 8x32-NVL. A model is one input pass, a
+// number of conv passes and one out-shuffle pass; every pass reads and writes
+// `targets` RGBA textures (four channels each).
+struct CunnyModel_t
+{
+	ShaderType passes[k_nCunnyMaxPasses];
+	uint32_t passCount;
+	uint32_t targets;
+};
+
+static const CunnyModel_t kCunnyModels[k_nCunnyModels] = {
+	{ { SHADER_TYPE_CUNNY_4X12_IN, SHADER_TYPE_CUNNY_4X12_CONV1, SHADER_TYPE_CUNNY_4X12_CONV2, SHADER_TYPE_CUNNY_4X12_CONV3, SHADER_TYPE_CUNNY_4X12_CONV4, SHADER_TYPE_CUNNY_4X12_OUT }, 6, 3 },
+	{ { SHADER_TYPE_CUNNY_4X16_IN, SHADER_TYPE_CUNNY_4X16_CONV1, SHADER_TYPE_CUNNY_4X16_CONV2, SHADER_TYPE_CUNNY_4X16_CONV3, SHADER_TYPE_CUNNY_4X16_CONV4, SHADER_TYPE_CUNNY_4X16_OUT }, 6, 4 },
+	{ { SHADER_TYPE_CUNNY_4X24_IN, SHADER_TYPE_CUNNY_4X24_CONV1, SHADER_TYPE_CUNNY_4X24_CONV2, SHADER_TYPE_CUNNY_4X24_CONV3, SHADER_TYPE_CUNNY_4X24_CONV4, SHADER_TYPE_CUNNY_4X24_OUT }, 6, 6 },
+	{ { SHADER_TYPE_CUNNY_8X32_IN, SHADER_TYPE_CUNNY_8X32_CONV1, SHADER_TYPE_CUNNY_8X32_CONV2, SHADER_TYPE_CUNNY_8X32_CONV3, SHADER_TYPE_CUNNY_8X32_CONV4, SHADER_TYPE_CUNNY_8X32_CONV5, SHADER_TYPE_CUNNY_8X32_CONV6, SHADER_TYPE_CUNNY_8X32_CONV7, SHADER_TYPE_CUNNY_8X32_CONV8, SHADER_TYPE_CUNNY_8X32_OUT }, 10, 8 },
+};
+
+bool CVulkanDevice::createCunnyPipelines()
+{
+	for ( uint32_t model = 0; model < k_nCunnyModels; model++ )
+	{
+		const CunnyModel_t &desc = kCunnyModels[ model ];
+		for ( uint32_t pass = 0; pass < desc.passCount; pass++ )
+		{
+			VkComputePipelineCreateInfo pipelineInfo = {
+				.sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO,
+				.stage = {
+					.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+					.stage = VK_SHADER_STAGE_COMPUTE_BIT,
+					.module = m_shaderModules[ desc.passes[ pass ] ],
+					.pName = "main",
+				},
+				.layout = m_pipelineLayout
+			};
+
+			VkResult res = vk.CreateComputePipelines(device(), VK_NULL_HANDLE, 1, &pipelineInfo, nullptr, &m_cunnyPipelines[ model ][ pass ]);
+			if ( res != VK_SUCCESS )
+			{
+				vk_errorf(res, "vkCreateComputePipelines failed for CuNNy model %u pass %u", model, pass);
+				return false;
+			}
+		}
+	}
+
+	return true;
+}
