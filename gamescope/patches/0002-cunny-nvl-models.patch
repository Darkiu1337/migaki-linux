+// The vendored CuNNy networks are contiguous: `cunny` stays the name of the
+// 4x16-NVL model, the smaller/larger ones are `cunny-4x12|4x24|8x32`.
+static inline bool is_cunny_upscale_filter( GamescopeUpscaleFilter eFilter )
+{
+    return eFilter >= GamescopeUpscaleFilter::CUNNY_4X12_NVL &&
+        eFilter <= GamescopeUpscaleFilter::CUNNY_8X32_NVL;
+}
+
+static inline uint32_t cunny_upscale_model( GamescopeUpscaleFilter eFilter )
+{
+    return uint32_t( eFilter ) - uint32_t( GamescopeUpscaleFilter::CUNNY_4X12_NVL );
+}
