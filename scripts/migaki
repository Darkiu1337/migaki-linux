#!/bin/bash
# migaki — TUI front-end for the Migaki launchers (gum-based,
# matching the Omarchy terminal aesthetic).
#
# Usage: migaki [launch <name> | add | detect <path> | doctor | list | remove <name> | edit <name> | help]
#   No arguments opens the interactive menu.
# Game library lives in ~/.config/migaki/games.json
set -e
_SRC="${BASH_SOURCE[0]}"
while [ -L "$_SRC" ]; do _SRC="$(readlink "$_SRC")"; case "$_SRC" in /*) :;; *) _SRC="$(dirname "${BASH_SOURCE[0]}")/$_SRC";; esac; done
SCRIPT_DIR="$(cd "$(dirname "$_SRC")" && pwd)"
unset _SRC
# shellcheck disable=SC1091
source "$SCRIPT_DIR/migaki-lib.sh"
LIB="$HOME/.config/migaki/games.json"
MIGAKI_REPO="$(dirname "$SCRIPT_DIR")"

# Write/launch paths run through the shared core (one store, backups,
# validation) — see core/__main__.py.
core_cmd() { env PYTHONPATH="$MIGAKI_REPO" python3 -m core "$@"; }

need() { command -v "$1" >/dev/null 2>&1 || { echo "error: '$1' not found" >&2; exit 1; }; }
need gum
need jq
need python3

lib_init() {
  mkdir -p "$(dirname "$LIB")"
  [ -f "$LIB" ] || echo '{"games":{}}' > "$LIB"
  jq -e '.games' "$LIB" >/dev/null 2>&1 || echo '{"games":{}}' > "$LIB"
}

lib_get() { jq -r --arg id "$2" --arg f "$1" '.games[$id][$f] // empty' "$LIB" 2>/dev/null; }
lib_names() {
  # "id — name (runner, variant)" lines for pickers; echoes id after selection
  jq -r '.games | to_entries[] | "\(.key)\t\(.value.name) (\(.value.runner), \(.value.variant)\(if .value.translate.enabled == "1" then ", +translate" else "" end))"' "$LIB" 2>/dev/null
}

# Real Vulkan device names (plus "auto"), from the shared core. Names may
# contain spaces — consume with `gum filter`, never `gum choose`.
gpu_list() { core_cmd gpus; }

cmd_add() {
  local runner name path variant gpu fps hud
  runner="$(gum choose --header "Runner (limits shown)" \
    "proton — Windows games: D3D9-12/Vulkan get filtered, OpenGL titles run unfiltered" \
    "rpgmaker — RPGMaker dirs: MV/MZ get filtered, other engines redirect" \
    "native — Linux executables: Vulkan direct, OpenGL via Zink, 64-bit only" | cut -d' ' -f1)"
  [ -n "$runner" ] || exit 0
  case "$runner" in
    proton)
      if command -v zenity >/dev/null 2>&1 && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
        path="$(zenity --file-selection --title='Select Windows game executable' --file-filter='Windows executables | *.exe *.EXE' 2>/dev/null || true)"
      else
        path="$(gum input --header "Path to game .exe" --placeholder "/home/YOU/Downloads/Game/game.exe")"
      fi
      ;;
    rpgmaker)
      if command -v zenity >/dev/null 2>&1 && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
        path="$(zenity --file-selection --directory --title='Select RPGMaker game folder' 2>/dev/null || true)"
      else
        path="$(gum input --header "Path to game folder" --placeholder "/home/YOU/Downloads/Daily")"
      fi
      ;;
    native)
      if command -v zenity >/dev/null 2>&1 && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
        path="$(zenity --file-selection --title='Select game executable' 2>/dev/null || true)"
      else
        path="$(gum input --header "Path to game executable" --placeholder "/path/to/Game.sh")"
      fi
      ;;
  esac
  [ -n "$path" ] || { echo "no game selected."; exit 0; }
  [ -e "$path" ] || { echo "error: not found: $path" >&2; exit 1; }
  # Detection verify-and-switch: high/medium confidence detections that
  # disagree with the chosen runner get a confirm-to-switch prompt.
  # Runners also consume different path kinds (rpgmaker needs the folder,
  # proton/native need the file), so the detected root is adopted then.
  _det="$(ak_detect_engine "$path")"
  _eng="${_det%%|*}"; _r1="${_det#*|}"
  _drunner="${_r1%%|*}"; _r2="${_r1#*|}"
  _dconf="${_r2%%|*}"; _r3="${_r2#*|}"
  _droot="${_r3%%|*}"; _ddetail="${_r3#*|}"
  if [ "$_dconf" != "low" ] && [ "$_drunner" != "ask" ] && [ "$_drunner" != "$runner" ]; then
    echo "detected: $_ddetail -> runner '$_drunner' (confidence: $_dconf)"
    if gum confirm "Switch runner to '$_drunner'?"; then
      runner="$_drunner"
    fi
  fi
  # Reconcile the pick: point the runner at a real launch target (Ren'Py
  # native -> the .sh, rpgmaker -> the folder) and catch a Windows .exe under
  # the native runner (Ren'Py-without-Linux routes to proton; anything else
  # warns and offers the switch).
  _rec="$(ak_reconcile "$path" "$runner")"
  _rrunner="${_rec%%|*}"; _rest="${_rec#*|}"
  _rtarget="${_rest%%|*}"; _rest="${_rest#*|}"
  _rsev="${_rest%%|*}"; _rmsg="${_rest#*|}"
  if [ "$_rsev" = "warn" ]; then
    echo "$_rmsg"
    if gum confirm "Switch runner to proton?"; then runner="proton"; fi
  elif [ "$_rrunner" != "$runner" ]; then
    echo "$_rmsg"
    runner="$_rrunner"
  fi
  if [ -n "$_rtarget" ] && [ "$_rtarget" != "$path" ]; then
    echo "launch target: using $_rtarget"
    path="$_rtarget"
  fi
  unset _det _eng _r1 _drunner _r2 _dconf _r3 _droot _ddetail \
        _rec _rest _rrunner _rtarget _rsev _rmsg
  variant="$(gum choose --header "Filter (Restore 2D / Clear 3D)" \
    "L — strongest, highest GPU cost" \
    "M — balanced" \
    "S — lightest, cheapest" \
    "Soft_S — for aliased art, light" \
    "Soft_M — for aliased art, balanced" \
    "Soft_L — for aliased art, strong" \
    "VL — very large network, heavy" \
    "UL — ultra large network, heaviest" \
    "Soft_VL — soft-tuned very large, heavy" \
    "Soft_UL — soft-tuned ultra large, heaviest" \
    "Clear — 3D: sharpen soft/TAA image" \
    "Clear_Vivid — 3D: sharpness + color pop" \
    "Clear_AA — 3D: anti-aliasing + sharpness" | cut -d' ' -f1)"
  variant="${variant:-L}"
  gpu="$(gpu_list | gum filter --header "Game GPU (filter follows the game)" --placeholder "type to filter...")"
  gpu="${gpu:-auto (discrete GPU preferred)}"
  fps="$(gum input --header "FPS cap (number, or off)" --placeholder "60" --value "60")"
  fps="${fps:-60}"
  hud="0"
  gum confirm "Show fps overlay while playing?" && hud="1"
  lang=""
  if [ "$runner" = "proton" ] || [ "$runner" = "native" ]; then
    lang="$(gum choose --header "Game language (locale; some VNs need Japanese)" \
      "System default" "ja_JP.UTF-8" "zh_CN.UTF-8" "zh_TW.UTF-8" "ko_KR.UTF-8" \
      "Custom…" | cut -d' ' -f1)"
    if [ "$lang" = "Custom…" ]; then
      lang="$(gum input --header "Locale" --placeholder "ja_JP.UTF-8")"
    fi
    [ "$lang" = "System" ] && lang=""
  fi
  pmode="shared"
  if [ "$runner" = "proton" ]; then
    gum confirm "Separate Wine prefix for this game? (default: shared)" && pmode="game"
  fi
  tr_enabled="0"; tr_hook=""
  if [ "$runner" = "proton" ] && gum confirm "Translate Japanese dialogue via DeepL?"; then
    tr_enabled="1"
    tr_hook="$(gum input --header "Hook code (optional — auto-detect at first setup)" --placeholder "HSX10@54DC0:game.exe")"
  fi
  name="$(gum input --header "Display name" --placeholder "$(basename "$path")")"
  name="${name:-$(basename "$path")}"
  if [ "$runner" = "proton" ]; then
    if [ -e "$path" ] && [ -d "$(dirname "$path")/renpy" ]; then
      echo "note: Ren'Py title detected — ANGLE renderer will be forced automatically."
    fi
  fi
  local new_id
  new_id="$(core_cmd add --name "$name" --runner "$runner" --path "$path" \
    --variant "$variant" --gpu "$gpu" --fps "$fps" --hud "$hud" \
    --prefix-mode "$pmode" --lang "$lang" \
    --tr-enabled "$tr_enabled" --tr-hook "$tr_hook")"
  echo "added '$name' as id '$new_id'."
}

cmd_list() {
  local n
  n="$(jq '.games | length' "$LIB")"
  [ "$n" -gt 0 ] || { echo "library is empty — run: migaki add"; exit 0; }
  lib_names
}

pick_game() {
  local sel
  sel="$(lib_names | gum filter --header "Pick a game" --placeholder "type to filter...")"
  [ -n "$sel" ] || exit 0
  printf '%s' "$sel" | cut -f1
}

cmd_launch() {
  local id="${1:-}"
  [ -n "$id" ] || id="$(pick_game)"
  jq -e ".games[\"$id\"]" "$LIB" >/dev/null || { echo "error: unknown game id '$id'" >&2; exit 1; }
  exec env PYTHONPATH="$MIGAKI_REPO" python3 -m core launch "$id"
}

cmd_remove() {
  local id="${1:-}"
  [ -n "$id" ] || id="$(pick_game)"
  jq -e ".games[\"$id\"]" "$LIB" >/dev/null || { echo "error: unknown game id '$id'" >&2; exit 1; }
  gum confirm "Remove '$(lib_get name "$id")' from the library?" || exit 0
  core_cmd remove "$id"
  echo "removed '$id'."
}

cmd_edit() {
  local id="${1:-}"
  [ -n "$id" ] || id="$(pick_game)"
  jq -e ".games[\"$id\"]" "$LIB" >/dev/null || { echo "error: unknown game id '$id'" >&2; exit 1; }
  local field new
  local fields="variant gpu fps hud"
  local _erunner
  _erunner="$(lib_get runner "$id")"
  [ "$_erunner" = "proton" ] && fields="$fields prefix_mode"
  if [ "$_erunner" = "proton" ] || [ "$_erunner" = "native" ]; then
    fields="$fields lang"
  fi
  [ "$_erunner" = "proton" ] && fields="$fields translate translate_hook translate_thread"
  unset _erunner
  # shellcheck disable=SC2086
  field="$(gum choose --header "Edit what?" $fields)"
  [ -n "$field" ] || exit 0
  case "$field" in
    variant) new="$(gum choose "L" "M" "S" "Soft_S" "Soft_M" "Soft_L" "VL" "UL" "Soft_VL" "Soft_UL" "Clear" "Clear_Vivid" "Clear_AA")" ;;
    gpu) new="$(gpu_list | gum filter --header "Game GPU")"; ;;
    fps) new="$(gum input --header "FPS cap (number, or off)" --value "$(lib_get fps "$id")")" ;;
    hud) gum confirm "Show fps overlay?" && new="1" || new="0" ;;
    prefix_mode) gum confirm "Separate Wine prefix for this game? (default: shared)" && new="game" || new="shared" ;;
    lang)
      new="$(gum choose --header "Game language" "System default" "ja_JP.UTF-8" "zh_CN.UTF-8" "zh_TW.UTF-8" "ko_KR.UTF-8" "Custom…" | cut -d' ' -f1)"
      if [ "$new" = "Custom…" ]; then
        new="$(gum input --header "Locale" --placeholder "ja_JP.UTF-8")"
      fi
      [ "$new" = "System" ] && new=""
      ;;
    translate)
      gum confirm "Translate Japanese dialogue via DeepL?" && new="1" || new="0"
      core_cmd tset "$id" enabled "$new"
      echo "updated '$id': translate.enabled = $new"
      return 0
      ;;
    translate_hook)
      new="$(gum input --header "Hook code (empty = auto-detect at setup)" --value "$(jq -r --arg id "$id" '.games[$id].translate.hook_code // empty' "$LIB")")"
      core_cmd tset "$id" hook_code "$new"
      echo "updated '$id': translate.hook_code = ${new:-<auto-detect>}"
      return 0
      ;;
    translate_thread)
      cur="$(jq -r --arg id "$id" '.games[$id].translate.thread // "*"' "$LIB")"
      new="$(gum input --header "Thread name/number for the textbox (empty or * = follow Textractor's selection)" --value "$cur")"
      new="${new:-*}"
      core_cmd tset "$id" thread "$new"
      echo "updated '$id': translate.thread = $new"
      return 0
      ;;
  esac
  if [ "$field" != "lang" ] && [ -z "$new" ]; then
    exit 0
  fi
  core_cmd set "$id" "$field" "$new"
  echo "updated '$id': $field = ${new:-<system default>}"
}

cmd_menu() {
  while true; do
    local action
    action="$(gum choose --header "Migaki launcher" "Launch" "Add game" "Manage games" "Doctor" "Quit")"
    case "$action" in
      Launch) cmd_launch ;;
      "Add game") cmd_add ;;
      Doctor) "$SCRIPT_DIR/migaki-doctor.sh" || read -r -p "press Enter..." _ ;;
      "Manage games")
        local sub
        sub="$(gum choose --header "Manage" "List" "Edit" "Remove" "Back")"
        case "$sub" in
          List) cmd_list ;;
          Edit) cmd_edit ;;
          Remove) cmd_remove ;;
        esac
        ;;
      *) exit 0 ;;
    esac
  done
}

cmd_detect() {
  [ -n "${1:-}" ] || { echo "usage: migaki detect <path>" >&2; exit 1; }
  local out eng runner conf root detail
  out="$(ak_detect_engine "$1")"
  eng="${out%%|*}"; out="${out#*|}"
  runner="${out%%|*}"; out="${out#*|}"
  conf="${out%%|*}"; out="${out#*|}"
  root="${out%%|*}"; detail="${out#*|}"
  echo "engine:     $eng"
  echo "runner:     $runner"
  echo "confidence: $conf"
  echo "root:       $root"
  echo "detail:     $detail"
  echo "launch:     $(ak_launch_target "$1")"
}

usage() {
  echo "Migaki — game launcher with Anime4K Restore filters"
  echo "Usage: migaki [launch <id> | add | detect <path> | doctor | list | remove [id] | edit [id] | help]"
  echo "  No arguments opens the interactive menu."
}

lib_init
case "${1:-menu}" in
  launch) shift; cmd_launch "${1:-}" ;;
  add) cmd_add ;;
  detect) shift; cmd_detect "${1:-}" ;;
  doctor) shift; exec "$SCRIPT_DIR/migaki-doctor.sh" "$@" ;;
  list) cmd_list ;;
  remove) shift; cmd_remove "${1:-}" ;;
  edit) shift; cmd_edit "${1:-}" ;;
  help|--help|-h) usage ;;
  menu) cmd_menu ;;
  *) echo "error: unknown command '$1' (see: migaki help)" >&2; exit 1 ;;
esac
